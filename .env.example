# Used by npm start. Copy to .env locally; never commit real API keys.
WITNESS_LISTEN_ADDR=127.0.0.1:8094
WITNESS_0G_API_KEY=
WITNESS_0G_MODEL=0gm-1.0-35b-a3b
WITNESS_MAX_LIVE_CHECKS=30
WITNESS_IFF_ORIGIN=https://ifandonlyif.io

# JSON file for ONE endpoint already observed by IFF (see README).
# Do not point this at a secret file or a user-controlled path.
WITNESS_EXAMPLE_FILE=examples/iff-fixture.json

# Optional independently obtained full IFF receipt key fingerprints, comma-separated.
# A key supplied by the bundle being verified is not an independent pin.
WITNESS_IFF_KEY_IDS=

# Optional independently confirmed public identity pins (not secrets).
# Compute: configure both or neither. These do not override provider routing.
WITNESS_0G_PROVIDER=
WITNESS_0G_SIGNER=
# AgenticID: configure all three or none. Chain ID is a decimal integer.
WITNESS_AGENT_SIGNER=
WITNESS_AGENT_CHAIN_ID=
WITNESS_AGENT_CONTRACT=

# Required only when exposing the server beyond loopback.
# WITNESS_PUBLIC_ORIGIN=https://labs.your-domain.example

# Optional shared passphrase gating live (not rehearsal) checks. Set this on a
# public deployment so the shared Router key/budget isn't usable by anyone who
# finds the URL. The loopback-only key-settings page is unavailable once
# WITNESS_PUBLIC_ORIGIN is set, so this is the only access control on that
# path; leave unset for local/loopback use where it isn't needed.
# WITNESS_LIVE_PASSWORD=
