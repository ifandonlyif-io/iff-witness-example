# Dedicated build context for -f Dockerfile.
# Default deny: runtime examples, credentials, worktree metadata, local outputs,
# and unrelated product source must not enter the build context or its cache.
**

!go.mod
!go.sum

# Local package closure from go list -deps ./cmd/witness.
!internal/prober/*.go
!util/*.go
!receipt/*.go
!*.go
!cmd/witness/*.go

# Committed public, non-secret fixtures: the default receipt and the
# Apostille walkthrough original. Other runtime
# example files stay excluded per the default-deny above.
!examples/iff-fixture.json
!examples/agentic-demo-bundle.json

# Browser build inputs, including the shared standalone receipt verifier.
!web/service-receipt.mjs
!package.json
!package-lock.json
!client/*.mjs
!scripts/build.mjs
!scripts/check-apostille-source.mjs
!client/third-party/apostille/*.mjs
!client/third-party/apostille/LICENSE
!client/third-party/apostille/SOURCE.json

# Exact current go:embed inputs; app.js is replaced by the browser build stage.
!web/app.js
!web/index.html
!web/mark.svg
!web/style.css
!web/settings.html
!web/settings.js
!web/apostille.html
!web/apostille-demo.css
!web/apostille-demo.js

# Keep test-only files out even when their source directory is allowlisted.
**/*_test.go
**/*.test.mjs
